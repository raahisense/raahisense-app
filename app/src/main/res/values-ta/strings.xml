    <string name="battery_opt_button">திரை அணைந்தும் இயங்க அனுமதி</string>
    <string name="cd_battery_opt">திரை அணைந்திருந்தாலும் பயன்பாடு இயங்க தொலைபேசி அமைப்பைத் திறக்கவும்</string>
    <string name="battery_hint_unrestricted">திரை அணைந்திருந்தாலும் இந்த தொலைபேசி தடை வழிகாட்டியை இயங்க அனுமதிக்கிறது.</string>
    <string name="battery_hint_restricted">திரை அணைந்தால் தொலைபேசி பயன்பாட்டை நிறுத்தலாம். கீழுள்ள பொத்தானைத் தொட்டு மின்கல கட்டுப்பாட்டை நீக்கவும்.</string>
    <string name="draft_banner">இவை வரைவு வாக்கியங்கள். தாய்மொழி பேசுபவர் சரிபார்த்த பிறகே பயன்படுத்தவும்.</string>
    <string name="voice_missing_screen">இந்த தொலைபேசியில் தமிழ் ஆஃப்லைன் குரல் இல்லை. எச்சரிக்கை ஆங்கிலத்தில் பேசப்படும். உரை-குரல் அமைப்பில் தமிழ் குரலைப் பதிவிறக்கவும்.</string>
