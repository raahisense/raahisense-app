<resources>
    <string name="app_name">தடை வழிகாட்டி</string>
    <string name="tagline">இது வெள்ளைப் பிரம்புக்கு உதவி. அதற்குப் பதில் அல்ல. இணையம் இல்லாமல் வேலை செய்யும்.</string>
    <string name="hold_phone">தொலைபேசியை நேராகப் பிடிக்கவும். பின் கேமரா நீங்கள் நடக்கும் திசையில் இருக்கட்டும்.</string>
    <string name="safety_note">முதலில் உதவியாளருடன் வீட்டுக்குள் பயிற்சி செய்யுங்கள். படிகள், குழிகள், கம்பங்கள் இதில் தெரியாது. பிரம்பை வைத்திருங்கள்.</string>
    <string name="action_start">தொடங்கு</string>
    <string name="action_stop">நிறுத்து</string>
    <string name="action_allow_camera">கேமரா அனுமதி</string>
    <string name="action_open_settings">அமைப்புகளைத் திற</string>
    <string name="cd_start">தடை எச்சரிக்கையைத் தொடங்கு</string>
    <string name="cd_stop">தடை எச்சரிக்கையை நிறுத்து</string>
    <string name="cd_allow_camera">தடை எச்சரிக்கைக்கு கேமரா அனுமதியை அளிக்கவும்</string>
    <string name="cd_open_settings">கேமராவை அனுமதிக்க தொலைபேசி அமைப்பைத் திறக்கவும்</string>
    <string name="status_ready">தயார். தொடங்க பெரிய பொத்தானைத் தொடவும்.</string>
    <string name="status_started">தொடங்கியது. தடைகளைக் கவனிக்கிறது.</string>
    <string name="status_stopped">நிறுத்தியது.</string>
    <string name="status_listening">தடைகளைக் கவனிக்கிறது.</string>
    <string name="status_camera_needed">கேமரா அணைந்துள்ளது. பெரிய பொத்தானைத் தொட்டு கேமராவை அனுமதிக்கவும். புகைப்படங்கள் சேமிக்கப்படாது.</string>
    <string name="status_camera_denied">கேமரா அனுமதி கிடைக்கவில்லை. கேமரா இல்லாமல் எச்சரிக்கை இல்லை.</string>
    <string name="status_camera_blocked">கேமரா அனுமதி தடுக்கப்பட்டுள்ளது. அமைப்புகள், அனுமதிகள், கேமராவை இயக்கவும்.</string>
    <string name="status_camera_error">கேமரா கிடைக்கவில்லை.</string>
    <string name="status_model_error">கண்டறிதல் மாதிரி திறக்கவில்லை. பயன்பாட்டை மூடி மீண்டும் திறக்கவும்.</string>
    <string name="status_tts_error">இந்த தொலைபேசியில் பேசும் குரல் இல்லை. டாக் பேக் அல்லது உரை-குரல் அமைப்பில் குரலைச் சேர்க்கவும்.</string>
    <string name="status_battery_settings_unavailable">இந்த தொலைபேசியில் மின்கல அமைப்பு திறக்கவில்லை.</string>
    <string name="prompt_allow_camera">தொலைபேசி கேமரா அனுமதி கேட்கும். அனுமதிக்கவும். இப்பயன்பாடு புகைப்படங்களைச் சேமிக்காது. இணையம் தேவையில்லை.</string>
